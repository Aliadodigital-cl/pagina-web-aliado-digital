---
import { buildWhatsAppLink } from "../../lib/utils";
import { Icon } from "astro-icon/components";

interface Props {
  whatsappNumber: string;
  message?: string;
}

const { whatsappNumber, message } = Astro.props;
const whatsappUrl = buildWhatsAppLink(
  whatsappNumber,
  message ?? "Hola! Necesito una web o automatizacion."
);
---

{
  whatsappUrl ? (
    <a
      id="whatsapp-floating-button"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 inline-flex items-center gap-2 rounded-full bg-whatsapp text-white font-semibold shadow-2xl group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
      aria-label="Contactar por WhatsApp"
    >
      <Icon name="simple-icons:whatsapp" class="h-5 w-5 text-white" aria-hidden="true" />
      <span
        class="whitespace-nowrap overflow-hidden max-w-0 opacity-0 -translate-x-1 transition-all duration-300 text-sm
        group-hover:max-w-[220px] group-hover:opacity-100 group-hover:translate-x-0"
      >
        Contactar por WhatsApp
      </span>
    </a>
  ) : null
}

<style>
  #whatsapp-floating-button {
    --wa-offset-x: 0px;
    --wa-scale: 1;
    transform: translateX(var(--wa-offset-x)) scale(var(--wa-scale));
    transform-origin: center;
    will-change: transform;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      opacity 0.2s ease;
    width: 52px;
    height: 52px;
    padding: 0;
    gap: 0;
    justify-content: center;
  }

  #whatsapp-floating-button:hover {
    --wa-scale: 1.02;
  }

  /* Solo se expande con hover real (mouse); en celular queda como círculo. */
  @media (hover: hover) and (pointer: fine) {
    #whatsapp-floating-button:hover {
      width: auto;
      padding: 0.75rem 1rem;
      gap: 0.5rem;
    }
  }

  @media not ((hover: hover) and (pointer: fine)) {
    #whatsapp-floating-button > span {
      display: none;
    }
  }

  /* Se oculta mientras el menú móvil está abierto (el menú trae su propio botón). */
  #whatsapp-floating-button.is-hidden {
    --wa-scale: 0.8;
    opacity: 0;
    pointer-events: none;
  }
</style>
