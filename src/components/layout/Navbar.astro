---
import { Icon } from "astro-icon/components";
import type { SiteSettings, NavLink, Content } from "../../lib/api/types";
import contentJson from "../../data/content.json";

interface Props {
  siteSettings: SiteSettings;
  navLinks?: NavLink[];
  forceTransparent?: boolean;
}

const content = contentJson as Content;
const fallbackNavLinks = content.navLinks ?? [];
const { siteSettings, navLinks = fallbackNavLinks, forceTransparent } = Astro.props as Props;
const pathname = Astro.url?.pathname ?? "/";
const isHome = pathname === "/" || pathname === "";
const isTransparent = Boolean(forceTransparent) || isHome;
const withHome = (href: string) => (href.startsWith("#") && !isHome ? `/${href}` : href);

// "Servicios" se reemplaza por el menú "Soluciones" y "Contacto" por el CTA.
const anchorOf = (href: string) => href.replace(/^\/?#/, "");
const textLinks = navLinks
  .filter((link) => !["servicios", "contacto"].includes(anchorOf(link.href)))
  .map((link) => {
    const href = withHome(link.href);
    const isPage = !href.includes("#");
    const isActive =
      isPage && href !== "/" && (pathname === href || pathname.startsWith(`${href}/`));
    return { ...link, href, isActive };
  });

const contactHref = withHome("/#contacto");
const ctaLabel = "Cotizar proyecto";

const solutionGroups = [
  {
    title: "Páginas web y sistemas",
    href: "/desarrollo",
    items: [
      {
        label: "Desarrollo web a medida",
        description: "Sitios rápidos, con WhatsApp y medición desde el día uno.",
        href: "/desarrollo",
        icon: "lucide:code-2"
      },
      {
        label: "Página web administrable",
        description: "Edita tu contenido sin depender de nadie.",
        href: "/servicios/web-administrable-contacto-clientes",
        icon: "lucide:layout-dashboard"
      },
      {
        label: "Sistemas de gestión",
        description: "Software a medida para ordenar tu operación.",
        href: "/servicios/sistema-gestion-negocio",
        icon: "lucide:layers"
      }
    ]
  },
  {
    title: "Campañas y presencia",
    href: "/marketing",
    items: [
      {
        label: "Meta Ads",
        description: "Campañas en Facebook e Instagram que traen consultas.",
        href: "/servicios/meta-ads",
        icon: "lucide:rocket"
      },
      {
        label: "Google Ads",
        description: "Aparece cuando te buscan, con cada peso medido.",
        href: "/servicios/google-ads",
        icon: "lucide:search"
      },
      {
        label: "Redes sociales",
        description: "Contenido constante y gestión de tus perfiles.",
        href: "/servicios/redes-sociales",
        icon: "lucide:messages-square"
      }
    ]
  }
];

const solutionsActive =
  pathname.startsWith("/servicios") ||
  pathname.startsWith("/desarrollo") ||
  pathname.startsWith("/marketing");

// Clases según el estado (transparente sobre el hero vs. sólido).
const fg = isTransparent ? "text-white group-[.scrolled]:text-content" : "text-content";
const linkBase =
  "relative inline-flex items-center gap-1 rounded-full px-3.5 py-2 text-sm font-medium transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60";
const linkTone = isTransparent
  ? "text-white/85 hover:text-white hover:bg-white/10 group-[.scrolled]:text-content/75 group-[.scrolled]:hover:text-content group-[.scrolled]:hover:bg-content/5"
  : "text-content/75 hover:text-content hover:bg-content/5";
const activeTone =
  "after:absolute after:inset-x-3.5 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-accent";
const ctaTone = isTransparent
  ? "bg-white text-secondary hover:bg-white/90 group-[.scrolled]:bg-primary group-[.scrolled]:text-white group-[.scrolled]:hover:bg-primary/90"
  : "bg-primary text-white hover:bg-primary/90";
const iconBtn = isTransparent
  ? "text-white/80 hover:text-white hover:bg-white/10 group-[.scrolled]:text-content/70 group-[.scrolled]:hover:text-content group-[.scrolled]:hover:bg-content/5"
  : "text-content/70 hover:text-content hover:bg-content/5";
const barTone = isTransparent ? "bg-white group-[.scrolled]:bg-content" : "bg-content";
---

<header
  id="main-header"
  data-transparent={isTransparent ? "true" : "false"}
  class:list={[
    "group fixed top-0 left-0 w-full z-50 border-b transition-[background-color,border-color,box-shadow] duration-300 ease-out",
    isTransparent
      ? "border-transparent"
      : "scrolled bg-surface/90 backdrop-blur-xl border-border/70 shadow-[0_1px_12px_rgba(15,23,42,0.06)]"
  ]}
  style="padding-top: var(--safe-top);"
>
  <nav
    aria-label="Principal"
    class="container mx-auto flex h-[var(--nav-h)] items-center justify-between gap-6 px-6 max-[360px]:px-4 sm:px-8"
  >
    <!-- Logo -->
    <a
      href={withHome("/#inicio")}
      aria-label={`${siteSettings.siteName} — Inicio`}
      class:list={[
        "flex shrink-0 items-center gap-2.5 font-display text-lg font-bold tracking-tight transition-colors max-[360px]:text-base sm:text-xl",
        fg
      ]}
    >
      <img
        src="/logo.svg"
        alt=""
        width="40"
        height="40"
        class="h-9 w-9 object-contain max-[360px]:h-8 max-[360px]:w-8 sm:h-10 sm:w-10"
        loading="eager"
        onerror="this.onerror=null;this.src='/logo.webp';"
      />
      <span>{siteSettings.siteName}</span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden lg:flex items-center gap-x-1">
      <li class="relative" id="solutions-menu">
        <button
          id="solutions-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="solutions-panel"
          class:list={[linkBase, linkTone, solutionsActive && activeTone]}
        >
          Soluciones
          <Icon
            name="lucide:chevron-down"
            class="h-4 w-4 transition-transform duration-200 [[aria-expanded=true]>&]:rotate-180"
            aria-hidden="true"
          />
        </button>

        <div
          id="solutions-panel"
          class="invisible absolute left-1/2 top-full z-10 w-[680px] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100"
          data-open="false"
        >
          <div
            class="grid grid-cols-2 gap-2 rounded-2xl border border-border bg-card p-3 text-content shadow-[0_24px_60px_rgba(15,23,42,0.16)]"
          >
            {
              solutionGroups.map((group) => (
                <div class="flex flex-col">
                  <a
                    href={group.href}
                    class="px-3 pb-2 pt-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-muted transition-colors hover:text-primary"
                  >
                    {group.title}
                  </a>
                  {group.items.map((item) => (
                    <a
                      href={item.href}
                      class:list={[
                        "group/item flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-surface-strong/60 focus-visible:bg-surface-strong/60 focus-visible:outline-none",
                        pathname === item.href && "bg-surface-strong/60"
                      ]}
                    >
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-surface text-primary transition-colors group-hover/item:border-primary/30 group-hover/item:text-accent">
                        <Icon name={item.icon} class="h-[18px] w-[18px]" aria-hidden="true" />
                      </span>
                      <span class="flex flex-col">
                        <span class="text-sm font-semibold leading-snug">{item.label}</span>
                        <span class="mt-0.5 text-[13px] leading-snug text-muted">
                          {item.description}
                        </span>
                      </span>
                    </a>
                  ))}
                </div>
              ))
            }
            <a
              href={withHome("/#servicios")}
              class="col-span-2 mt-1 flex items-center justify-between rounded-xl bg-surface-strong/50 px-4 py-3 text-sm font-medium transition-colors hover:bg-surface-strong"
            >
              <span>
                ¿No sabes por dónde partir?
                <span class="text-muted">Te orientamos sin costo.</span>
              </span>
              <span class="inline-flex items-center gap-1 font-semibold text-primary">
                Ver todas las soluciones
                <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
              </span>
            </a>
          </div>
        </div>
      </li>
      {
        textLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.isActive ? "page" : undefined}
              class:list={[linkBase, linkTone, link.isActive && activeTone]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Actions -->
    <div class="flex items-center gap-x-1.5">
      <button
        id="theme-toggle"
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-full transition-colors max-[360px]:hidden",
          iconBtn
        ]}
        type="button"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:sun-medium" class="h-[18px] w-[18px]" data-theme-icon="light" />
        <Icon name="lucide:moon-star" class="h-[18px] w-[18px] hidden" data-theme-icon="dark" />
      </button>

      <a
        href={contactHref}
        class:list={[
          "hidden sm:inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm font-semibold shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60",
          ctaTone
        ]}
      >
        {ctaLabel}
        <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class:list={[
          "lg:hidden flex flex-col justify-center items-center gap-y-1.5 w-10 h-10 rounded-full transition-colors",
          iconBtn
        ]}
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
      >
        <span
          class:list={[
            "w-5 h-0.5 rounded-full transition-transform duration-300 ease-in-out origin-center",
            barTone
          ]}
          aria-hidden="true"></span>
        <span
          class:list={[
            "w-5 h-0.5 rounded-full transition-transform duration-300 ease-in-out origin-center",
            barTone
          ]}
          aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Menu Panel -->
<div
  id="mobile-menu-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  aria-hidden="true"
  inert
  class="fixed top-0 right-0 z-40 flex h-full w-[22rem] max-w-[90vw] translate-x-full flex-col border-l border-border bg-surface text-content shadow-2xl transition-transform duration-300 ease-in-out lg:hidden"
  style="padding-top: calc(var(--nav-h) + var(--safe-top));"
>
  <div class="flex-1 overflow-y-auto px-5 pb-6 pt-4">
    <details class="group/acc border-b border-border/70 pb-2" open={solutionsActive}>
      <summary
        class="flex cursor-pointer list-none items-center justify-between rounded-xl px-3 py-3 text-base font-semibold [&::-webkit-details-marker]:hidden"
      >
        Soluciones
        <Icon
          name="lucide:chevron-down"
          class="h-5 w-5 text-muted transition-transform duration-200 group-open/acc:rotate-180"
          aria-hidden="true"
        />
      </summary>
      <div class="flex flex-col gap-1 pb-2">
        {
          solutionGroups.map((group) => (
            <>
              <p class="px-3 pb-1 pt-3 text-[11px] font-semibold uppercase tracking-[0.16em] text-muted">
                {group.title}
              </p>
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class="mobile-nav-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-[15px] font-medium transition-colors hover:bg-surface-strong/70"
                >
                  <Icon
                    name={item.icon}
                    class="h-[18px] w-[18px] text-primary"
                    aria-hidden="true"
                  />
                  {item.label}
                </a>
              ))}
            </>
          ))
        }
      </div>
    </details>

    <ul class="mt-2 flex flex-col gap-0.5">
      {
        textLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.isActive ? "page" : undefined}
              class:list={[
                "mobile-nav-link flex items-center justify-between rounded-xl px-3 py-3 text-base font-semibold transition-colors hover:bg-surface-strong/70",
                link.isActive && "bg-surface-strong/70 text-primary"
              ]}
            >
              {link.label}
              <Icon name="lucide:chevron-right" class="h-4 w-4 text-muted" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-border bg-surface-strong/40 px-5 pb-24 pt-5">
    <a
      href={contactHref}
      class="mobile-nav-link flex w-full items-center justify-center gap-2 rounded-full bg-primary px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary/90"
    >
      {ctaLabel}
      <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
    </a>
    <p class="mt-3 text-center text-xs text-muted">
      Respondemos de lunes a viernes en horario hábil.
    </p>
  </div>
</div>
<!-- Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-30 hidden bg-secondary/50 backdrop-blur-[2px] lg:hidden"
>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // --- Theme Toggler ---
    const themeToggleBtn = document.getElementById("theme-toggle");
    const THEME_KEY = "theme";

    const setThemeIcon = (theme) => {
      themeToggleBtn?.querySelectorAll("[data-theme-icon]").forEach((icon) => {
        icon.classList.toggle("hidden", icon.getAttribute("data-theme-icon") !== theme);
      });
    };

    const applyTheme = (theme) => {
      document.documentElement.classList.toggle("dark", theme === "dark");
      try {
        localStorage.setItem(THEME_KEY, theme);
      } catch {
        // storage no disponible (modo privado)
      }
      setThemeIcon(theme);
    };

    let storedTheme = null;
    try {
      storedTheme = localStorage.getItem(THEME_KEY);
    } catch {
      // storage no disponible (modo privado)
    }
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    applyTheme(storedTheme || (prefersDark ? "dark" : "light"));

    themeToggleBtn?.addEventListener("click", () => {
      const nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
      applyTheme(nextTheme);
    });

    // --- Header state (transparent -> solid) ---
    const header = document.getElementById("main-header");
    const isTransparent = header?.dataset.transparent === "true";
    const SOLID = [
      "scrolled",
      "bg-surface/90",
      "backdrop-blur-xl",
      "border-border/70",
      "shadow-[0_1px_12px_rgba(15,23,42,0.06)]"
    ];
    let menuOpen = false;
    const syncHeader = () => {
      if (!isTransparent || !header) return;
      const solid = menuOpen || window.scrollY > 24;
      SOLID.forEach((cls) => header.classList.toggle(cls, solid));
      header.classList.toggle("border-transparent", !solid);
    };
    window.addEventListener("scroll", syncHeader, { passive: true });
    syncHeader();

    // --- Desktop "Soluciones" dropdown ---
    const solMenu = document.getElementById("solutions-menu");
    const solToggle = document.getElementById("solutions-toggle");
    const solPanel = document.getElementById("solutions-panel");
    let closeTimer;
    const setSolutions = (open) => {
      if (!solToggle || !solPanel) return;
      solToggle.setAttribute("aria-expanded", String(open));
      solPanel.dataset.open = String(open);
    };
    solToggle?.addEventListener("click", () =>
      setSolutions(solToggle.getAttribute("aria-expanded") !== "true")
    );
    solMenu?.addEventListener("mouseenter", () => {
      clearTimeout(closeTimer);
      setSolutions(true);
    });
    solMenu?.addEventListener("mouseleave", () => {
      closeTimer = setTimeout(() => setSolutions(false), 120);
    });
    solMenu?.addEventListener("focusout", (e) => {
      if (!solMenu.contains(e.relatedTarget)) setSolutions(false);
    });
    document.addEventListener("click", (e) => {
      if (solMenu && !solMenu.contains(e.target)) setSolutions(false);
    });

    // --- Mobile Menu ---
    const menuToggle = document.getElementById("mobile-menu-toggle");
    const menuPanel = document.getElementById("mobile-menu-panel");
    const menuBackdrop = document.getElementById("mobile-menu-backdrop");
    const floatingWhatsappButton = document.getElementById("whatsapp-floating-button");
    const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
    const hamburgerSpans = menuToggle?.querySelectorAll("span");

    const openMenu = () => {
      menuOpen = true;
      menuPanel.classList.remove("translate-x-full");
      menuPanel.removeAttribute("inert");
      menuPanel.setAttribute("aria-hidden", "false");
      menuBackdrop.classList.remove("hidden");
      floatingWhatsappButton?.classList.add("is-expanded");
      document.body.style.overflow = "hidden";
      menuToggle.setAttribute("aria-expanded", "true");
      menuToggle.setAttribute("aria-label", "Cerrar menú");
      hamburgerSpans[0].style.transform = "translateY(4px) rotate(45deg)";
      hamburgerSpans[1].style.transform = "translateY(-4px) rotate(-45deg)";
      syncHeader();
      menuPanel.querySelector("summary, a")?.focus({ preventScroll: true });
    };

    const closeMenu = () => {
      if (!menuOpen) return;
      menuOpen = false;
      menuPanel.classList.add("translate-x-full");
      menuPanel.setAttribute("inert", "");
      menuPanel.setAttribute("aria-hidden", "true");
      menuBackdrop.classList.add("hidden");
      floatingWhatsappButton?.classList.remove("is-expanded");
      document.body.style.overflow = "";
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.setAttribute("aria-label", "Abrir menú");
      hamburgerSpans.forEach((span) => (span.style.transform = ""));
      syncHeader();
    };

    menuToggle?.addEventListener("click", () => (menuOpen ? closeMenu() : openMenu()));
    menuBackdrop?.addEventListener("click", closeMenu);
    mobileNavLinks.forEach((link) => link.addEventListener("click", closeMenu));
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
      if (e.matches) closeMenu();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (menuOpen) {
        closeMenu();
        menuToggle?.focus();
      } else if (solToggle?.getAttribute("aria-expanded") === "true") {
        setSolutions(false);
        solToggle.focus();
      }
    });
  });
</script>
