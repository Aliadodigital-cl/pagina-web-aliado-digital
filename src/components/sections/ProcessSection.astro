---
// Nuestro Proceso - Seccion con diseno escalera y animaciones scroll
interface ProcessStep {
  num: string;
  title: string;
  desc: string;
  result: string;
  img: string;
}

interface Props {
  sectionId?: string;
  title?: string;
  description?: string;
  steps?: ProcessStep[];
}

const DEFAULT_STEPS: ProcessStep[] = [
  {
    num: "01",
    title: "Conocemos tu negocio",
    desc: "Conversamos contigo para entender tus objetivos, audiencia y desafíos únicos.",
    result: "Estrategia personalizada",
    img: "/images/nuestro-proceso/paso-01.webp",
  },
  {
    num: "02",
    title: "Diseñamos y desarrollamos",
    desc: "Creamos un diseño que refleja tu identidad y lo transformamos en código limpio y optimizado.",
    result: "Sitio web funcional",
    img: "/images/nuestro-proceso/paso-02.webp",
  },
  {
    num: "03",
    title: "Testeamos y lanzamos",
    desc: "Revisamos rendimiento, accesibilidad y compatibilidad. Publicamos tu proyecto al mundo.",
    result: "Calidad garantizada",
    img: "/images/nuestro-proceso/paso-03.webp",
  },
  {
    num: "04",
    title: "Te acompañamos siempre",
    desc: "Seguimos a tu lado con soporte, actualizaciones y mejoras continuas.",
    result: "Tranquilidad total",
    img: "/images/nuestro-proceso/paso-04.webp",
  },
];

const {
  sectionId = "proceso",
  title = "Así impulsamos tu proyecto",
  description =
    "Nuestro proceso está pensado para que siempre sepas qué estamos haciendo, en qué etapa estás y cómo avanzamos hacia el resultado final.",
  steps = DEFAULT_STEPS,
} = Astro.props as Props;
---

<section id={sectionId} class="section-band relative py-20 md:py-28">

  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4 text-content">
        {title}
      </h2>
      <p class="text-lg md:text-xl text-muted max-w-2xl mx-auto">
        {description}
      </p>
    </div>

    <!-- Steps - Diseño Brickwork Compacto -->
    <div class="relative max-w-6xl mx-auto">
      {steps.map((step, index) => {
        const isEven = index % 2 === 0;
        const delay = (index + 1) * 180;
        
        return (
          <div 
            class="process-step opacity-0 mb-6 md:mb-8"
            data-step={index}
            style={`--d: ${delay}ms`}
          >
            <!-- Desktop: Layout compacto escalonado -->
            <div class={`grid grid-cols-1 lg:grid-cols-2 gap-6 items-center ${isEven ? '' : 'lg:grid-flow-dense'}`}>
              
              <!-- Imagen -->
              <div class={`${isEven ? 'lg:order-1' : 'lg:order-2'}`}>
                <div class="relative group">
                  <div class="relative aspect-[4/3] rounded-2xl overflow-hidden border border-border bg-surface-strong shadow-soft">
                    <img 
                      src={step.img} 
                      alt={step.title}
                      width="800"
                      height="600"
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>

              <!-- Contenido de texto -->
              <div class={`${isEven ? 'lg:order-2' : 'lg:order-1'}`}>
                <article class="relative bg-card border border-border rounded-2xl p-6 shadow-soft">
                  <!-- Número badge -->
                  <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-brand-gradient text-white font-bold text-xl mb-4 shadow-md" aria-hidden="true">
                    {step.num}
                  </div>

                  <!-- Título -->
                  <h3 class="text-xl md:text-2xl font-bold mb-2 text-content">
                    {step.title}
                  </h3>

                  <!-- Descripción -->
                  <p class="text-muted mb-3 text-sm md:text-base leading-relaxed">
                    {step.desc}
                  </p>

                  <!-- Mini resultado -->
                  <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-primary/[0.07] border border-primary/20 rounded-full">
                    <svg class="w-4 h-4 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span class="text-xs md:text-sm font-semibold text-link">
                      {step.result}
                    </span>
                  </div>
                </article>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- Estilos para animaciones -->
<style>
  .process-step {
    transition: 
      opacity 0.8s ease-out,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.8s ease-out;
    transition-delay: var(--d, 0ms);
    transform: translateY(30px);
    filter: blur(8px);
  }

  .process-step.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
</style>

<!-- Script IntersectionObserver -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const steps = document.querySelectorAll('.process-step');
    
    const observerOptions = {
      root: null,
      threshold: 0.15,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          // Opcional: dejar de observar después de animar
          // observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    steps.forEach(step => observer.observe(step));
  });
</script>
