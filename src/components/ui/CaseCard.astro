---
import type { CaseStudy } from "../../lib/api/types";

interface Props {
  caseItem: CaseStudy;
  origin?: "home" | "marketing";
}

const { caseItem } = Astro.props as Props;

const clientName = (caseItem.clientName ?? "").trim();
const title = (caseItem.title ?? "").trim() || clientName;
const summary = (caseItem.summary ?? "").trim();
const truncateText = (text: string, maxChars: number) => {
  if (text.length <= maxChars) return text;
  const clipped = text.slice(0, maxChars);
  const lastSpace = clipped.lastIndexOf(" ");
  const safeCut = lastSpace > Math.floor(maxChars * 0.6) ? lastSpace : maxChars;
  return `${clipped.slice(0, safeCut).trimEnd()}...`;
};
const summaryPreview = truncateText(summary, 175);
const coverAlt =
  caseItem.coverImageAlt || `Caso de éxito de ${caseItem.clientName || title}`;
// Sin ?from=marketing: nada lo leía y Google indexaba cada caso dos veces.
const href = `/casos/${caseItem.slug}/`;

const projectContext = [
  caseItem.title ?? "",
  summary,
  caseItem.ctaPrimaryLabel ?? "",
]
  .join(" ")
  .toLowerCase();

const hasMarketingIntent =
  /(marketing|campa|ads|meta|google|leads|trafico|embudo|social|conversion)/.test(
    projectContext,
  );
const hasDevelopmentIntent =
  /(web|landing|sitio|pagina|plataforma|sistema|desarrollo|software|app|catalogo|pedidos)/.test(
    projectContext,
  );

const manualProjectTypeBySlug: Record<
  string,
  "Marketing" | "Desarrollo Web" | "Proyecto Mixto"
> = {
  "propiedades-arenas": "Proyecto Mixto",
};

const manualProjectType = manualProjectTypeBySlug[caseItem.slug];
const projectTypeLabel =
  manualProjectType ??
  (hasMarketingIntent && hasDevelopmentIntent
    ? "Proyecto Mixto"
    : hasMarketingIntent
      ? "Marketing"
      : "Desarrollo Web");

---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-soft transition-all duration-300 hover:-translate-y-1 hover:border-content/20 hover:shadow-featured"
>
  <!-- Fondo de marca igual en todas; la captura va en una ventana -->
  <div class="bg-brand-gradient relative aspect-[16/10] overflow-hidden">
    {
      caseItem.coverImage ? (
        <div class="absolute inset-x-[8%] top-[23%] -bottom-[6%] overflow-hidden rounded-t-xl border border-white/20 bg-secondary shadow-2xl shadow-black/40 transition-transform duration-500 ease-out group-hover:-translate-y-1.5">
          <div class="flex h-5 items-center gap-1 bg-secondary-lift px-2.5" aria-hidden="true">
            <span class="h-1.5 w-1.5 rounded-full bg-white/30" />
            <span class="h-1.5 w-1.5 rounded-full bg-white/30" />
            <span class="h-1.5 w-1.5 rounded-full bg-white/30" />
          </div>
          <img
            src={caseItem.coverImage}
            alt={coverAlt}
            width="800"
            height="500"
            loading="lazy"
            decoding="async"
            class="h-[calc(100%-1.25rem)] w-full object-cover object-left-top"
          />
        </div>
      ) : null
    }

    {
      caseItem.industry && (
        <div class="absolute left-3 top-3 inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white ring-1 ring-inset ring-white/25 backdrop-blur-md">
          {caseItem.industry}
        </div>
      )
    }
  </div>

  <div class="flex min-h-[220px] flex-1 flex-col p-6">
    <div class="space-y-2">
      {
        clientName && (
          <p class="h-4 max-w-full truncate text-xs font-semibold uppercase tracking-wider text-muted">
            {clientName}
          </p>
        )
      }

      <div class="h-16">
        <h3
          class="line-clamp-2 max-w-full text-xl font-bold leading-tight text-content md:text-2xl"
        >
          {title}
        </h3>
      </div>
    </div>

    {
      summaryPreview && (
        <p
          class="mt-3 h-[5.5rem] max-w-[56ch] overflow-hidden text-sm leading-relaxed text-muted"
        >
          {summaryPreview}
        </p>
      )
    }

    <div class="mt-auto flex items-end justify-between gap-3 pt-4">
      <div
        class="flex items-center gap-2 text-sm font-semibold text-link transition-all duration-300 group-hover:gap-3"
      >
        <span>Ver caso</span>
        <svg
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M13 7l5 5m0 0l-5 5m5-5H6"
          ></path>
        </svg>
      </div>

      <p
        class="chip"
      >
        {projectTypeLabel}
      </p>
    </div>
  </div>
</a>

