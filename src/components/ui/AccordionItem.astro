---
import { Icon } from "astro-icon/components";

interface Props {
  question: string;
  answer: string;
  defaultOpen?: boolean;
}

const { question, answer, defaultOpen = false } = Astro.props;
---
<details 
  class="group rounded-2xl border border-border bg-card shadow-sm transition-shadow duration-300 hover:shadow-soft"
  open={defaultOpen}
>
  <summary class="flex cursor-pointer list-none items-center justify-between p-6">
    <span class="text-lg font-semibold text-content">
      {question}
    </span>
    <div class="rounded-full p-2 transition-colors bg-surface-strong group-hover:bg-border/70">
      <Icon name="lucide:chevron-down" class="h-5 w-5 text-content transition-transform duration-300 ease-in-out group-open:-rotate-180" />
    </div>
  </summary>

  <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out group-open:grid-rows-[1fr]">
    <div class="overflow-hidden">
      <p class="px-6 pb-6 text-base text-muted">
        {answer}
      </p>
    </div>
  </div>
</details>
